{
  "pluginAlias": "WinPCTV",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Exposes one or more Windows PCs as HomeKit Television accessories. Turns on via Wake-on-LAN and off/status via Airytec Switch Off's web interface.",
  "schema": {
    "type": "object",
    "properties": {
      "devices": {
        "type": "array",
        "title": "Devices",
        "items": {
          "type": "object",
          "properties": {
            "name": { "title": "Name", "type": "string", "required": true },
            "mac": { "title": "MAC Address", "type": "string", "required": true },
            "ip": { "title": "IP Address", "type": "string", "required": true },
            "broadcastAddress": { "title": "Broadcast Address", "type": "string", "default": "255.255.255.255" },
            "wolPort": { "title": "Wake-on-LAN Port", "type": "integer", "default": 9 },
            "httpPort": { "title": "Airytec Port", "type": "integer", "default": 8000 },
            "username": { "title": "Airytec Username", "type": "string" },
            "password": { "title": "Airytec Password", "type": "string" },
            "statusPath": { "title": "Status Path", "type": "string", "default": "/" },
            "shutdownPath": { "title": "Shutdown Path", "type": "string", "default": "/?action=System.Shutdown" },
            "pollInterval": { "title": "Poll Interval (seconds)", "type": "integer", "default": 60, "minimum": 15 },
            "httpTimeoutMs": { "title": "HTTP Timeout (ms)", "type": "integer", "default": 4000 }
          }
        }
      }
    }
  },
  "form": [
    {
      "type": "array",
      "key": "devices",
      "name": "Devices",
      "items": [
        "devices[].name",
        "devices[].mac",
        "devices[].ip",
        "devices[].username",
        "devices[].password",
        "devices[].httpPort",
        "devices[].pollInterval",
        {
          "type": "fieldset",
          "expandable": true,
          "title": "Advanced",
          "items": [
            "devices[].broadcastAddress",
            "devices[].wolPort",
            "devices[].statusPath",
            "devices[].shutdownPath",
            "devices[].httpTimeoutMs"
          ]
        }
      ]
    }
  ]
}
